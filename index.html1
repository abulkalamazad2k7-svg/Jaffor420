<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Smart Duty Roster with Live Countdown</title>

<style>
body{
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background:#eef2f5;
    padding:20px;
    margin:0;
}

.container{
    max-width:750px;
    margin:auto;
    background:white;
    padding:25px;
    border-radius:15px;
    box-shadow:0 8px 20px rgba(0,0,0,0.1);
}

h2{
    text-align:center;
    color:#1565c0;
    margin-top: 0;
}

/* বর্তমান সময় প্রদর্শনের ঘড়ি */
.live-clock {
    background: #1565c0;
    color: white;
    text-align: center;
    padding: 12px;
    border-radius: 10px;
    margin-bottom: 20px;
    font-size: 1.1rem;
    font-weight: bold;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
}

.controls{
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
    background: #f8f9fa;
    padding: 15px;
    border-radius: 10px;
}

.control-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

input, button{
    padding:10px 15px;
    border-radius:8px;
    border:1px solid #ccc;
    font-size: 14px;
}

button{
    background:#1565c0;
    color:white;
    cursor:pointer;
    border: none;
    font-weight: bold;
    transition: background 0.3s;
    margin-top: auto;
}

button:hover{
    background:#0d47a1;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:10px;
}

th, td{
    border:1px solid #e0e0e0;
    padding:12px 8px;
    text-align:center;
    font-size: 14px;
}

th{
    background:#1565c0;
    color:white;
}

.off{
    background:#ffebee;
    color:#c62828;
    font-weight:bold;
}

.shift1{ background:#e3f2fd; }
.shift2{ background:#fff3e0; }
.shift3{ background:#ede7f6; }

/* স্ট্যাটাস ব্যাজসমূহ */
.badge {
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: bold;
    display: inline-block;
}

.badge-running { background: #4caf50; color: white; }
.badge-finished { background: #9e9e9e; color: white; }
.badge-upcoming { background: #2196f3; color: white; }
.badge-off { background: #e53935; color: white; }

.timer-text {
    font-size: 12px;
    font-weight: bold;
    color: #2e7d32;
    margin-top: 5px;
    background: #e8f5e9;
    padding: 4px 8px;
    border-radius: 5px;
    display: inline-block;
}

.upcoming-timer {
    color: #1565c0;
    background: #e3f2fd;
}

/* টেবিলের নিচের নোটিশ কার্ডের স্টাইল */
.notice-card {
    margin-top: 20px;
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-left: 5px solid #1565c0;
    border-radius: 10px;
    padding: 15px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}

.notice-title {
    font-size: 16px;
    font-weight: bold;
    color: #1565c0;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.notice-card ul {
    margin: 5px 0 10px 0;
    padding-left: 20px;
    font-size: 13px;
    color: #333;
    line-height: 1.6;
}

.health-tips {
    background: #f1f8e9;
    color: #2e7d32;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
}
</style>

</head>

<body>

<div class="container">

<h2>আবুল কালাম আজাদ</h2>

<!-- লাইভ টাইম ক্লক -->
<div class="live-clock" id="liveClock">
    বর্তমান সময়: লোড হচ্ছে...
</div>

<div class="controls">
    <div class="control-group">
        <label>মাস:</label>
        <input type="month" id="month">
    </div>
    <div class="control-group">
        <label>তারিখ (একদিনের জন্য):</label>
        <input type="date" id="selectedDate">
    </div>
    <button onclick="createDuty()">ফিল্টার করুন</button>
    <button onclick="showAllMonth()" style="background:#455a64;">পুরা মাস দেখুন</button>
</div>

<table>
<thead>
<tr>
<th>তারিখ</th>
<th>বার</th>
<th>ডিউটি ও সময়</th>
<th>অবস্থা (স্ট্যাটাস)</th>
</tr>
</thead>

<tbody id="result"></tbody>

</table>

<!-- লাল চিহ্নিত জায়গায় দেখানোর নোটিশ বক্স -->
<div id="noticeContainer"></div>

</div>


<script>

const shifts = [
    { 
        name: "Shift 1", 
        startHour: 6, 
        endHour: 14, 
        isOvernight: false, 
        timeText: "06:00 AM - 02:00 PM",
        routine: [
            "০৬:০০ - ০৭:০০ | ডিউটি গ্রহণ, এলাকা চেক, গেট/পোস্টের অবস্থা দেখা",
            "০৭:০০ - ০৯:০০ | নিয়মিত পাহারা, টহল, আগত-যাতায়াত লক্ষ্য করা",
            "০৯:০০ - ০৯:১৫ | পানি পান ও ছোট বিরতি",
            "০৯:১৫ - ১১:০০ | ডিউটি চালিয়ে যাওয়া, নিরাপত্তা পর্যবেক্ষণ",
            "১১:০০ - ১২:০০ | টহল ও প্রয়োজনীয় নোট লেখা",
            "১২:০০ - ০১:৩০ | সতর্কভাবে পাহারা, গুরুত্বপূর্ণ স্থানগুলো চেক করা",
            "০১:৩০ - ০২:০০ | রিপোর্ট লেখা ও পরবর্তী গার্ডকে দায়িত্ব বুঝিয়ে দেওয়া"
        ],
        tips: "পর্যাপ্ত পানি পান করুন এবং সকালে পুষ্টিকর খাবার খেয়ে ডিউটি শুরু করুন।"
    },
    { 
        name: "Shift 2", 
        startHour: 22, 
        endHour: 6, 
        isOvernight: true, 
        timeText: "10:00 PM - 06:00 AM",
        routine: [
            "১০:০০ - ১১:০০ | দায়িত্ব গ্রহণ, পুরো এলাকা ভালোভাবে দেখা",
            "১১:০০ - ০১:০০ | পাহারা, টহল, গেট পর্যবেক্ষণ",
            "০১:০০ - ০১:১৫ | পানি পান, হালকা হাঁটাহাঁটি",
            "০১:১৫ - ০৩:০০ | সতর্ক অবস্থায় ডিউটি, নিয়মিত চেক",
            "০৩:০০ - ০৪:০০ | টহল, ঘুমভাব এলে হাঁটাহাঁটি করা",
            "০৪:০০ - ০৫:৩০ | ভোরের আগে গুরুত্বপূর্ণ জায়গা পরীক্ষা",
            "০৫:৩০ - ০৬:০০ | রিপোর্ট তৈরি ও দায়িত্ব হস্তান্তর"
        ],
        tips: "রাতে ঘুমভাব এলে হাঁটাহাঁটি করুন। দিনে ঘুমানোর জন্য শান্ত ও অন্ধকার জায়গা বেছে নিন।"
    },
    { 
        name: "Shift 3", 
        startHour: 14, 
        endHour: 22, 
        isOvernight: false, 
        timeText: "02:00 PM - 10:00 PM",
        routine: [
            "০২:০০ - ০৩:০০ | ডিউটি গ্রহণ, এলাকা পরীক্ষা",
            "০৩:০০ - ০৫:০০ | পাহারা, আগত লোকজন ও যানবাহন লক্ষ্য করা",
            "০৫:০০ - ০৫:১৫ | পানি পান ও ছোট বিরতি",
            "০৫:১৫ - ০৭:০০ | নিয়মিত টহল ও নিরাপত্তা দেখা",
            "০৭:০০ - ০৮:৩০ | বেশি সতর্ক থাকা, গেট/এলাকা পর্যবেক্ষণ",
            "০৮:৩০ - ০৯:৩০ | শেষ পর্যায়ের চেক ও রিপোর্ট প্রস্তুতি",
            "০৯:৩০ - ১০:০০ | দায়িত্ব বুঝিয়ে দেওয়া"
        ],
        tips: "ভারী বা তেল-মশলাযুক্ত খাবার এড়িয়ে চলুন। মাঝেমধ্যে শরীর স্ট্রেচ করুন।"
    }
];

function padTwo(num) {
    return num.toString().padStart(2, '0');
}

function updateClock() {
    const now = new Date();
    const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' };
    document.getElementById("liveClock").innerText = "বর্তমান সময়: " + now.toLocaleDateString("bn-BD", options);
}

// চলতি সপ্তাহের শনিবারের তারিখ নির্ধারণ করার ফাংশন
function getBaseSaturday() {
    let now = new Date();
    let day = now.getDay(); 
    let diffToSaturday = (day === 6) ? 0 : -(day + 1);
    let sat = new Date(now);
    sat.setDate(now.getDate() + diffToSaturday);
    sat.setHours(0, 0, 0, 0);
    return sat;
}

const baseSaturday = getBaseSaturday();

function createDuty(){
    let monthValue = document.getElementById("month").value;
    let dateValue = document.getElementById("selectedDate").value;

    if(!monthValue){
        alert("মাস নির্বাচন করুন");
        return;
    }

    let [year, month] = monthValue.split("-");
    let days = new Date(year, month, 0).getDate();
    let html = "";

    let targetDay = dateValue ? new Date(dateValue).getDate() : null;
    let targetMonth = dateValue ? new Date(dateValue).getMonth() + 1 : null;
    let targetYear = dateValue ? new Date(dateValue).getFullYear() : null;

    const now = new Date();
    let activeShiftForNotice = null;

    for(let d = 1; d <= days; d++){
        let date = new Date(year, month - 1, d);
        let dayName = date.toLocaleDateString("bn-BD", { weekday: "long" });

        let duty = "";
        let timeText = "";
        let cls = "";
        let statusBadge = "";
        let timerInfo = "";

        // শুক্রবার Off Day
        let isOffDay = (date.getDay() === 5);

        // শনিবার থেকে শুক্রবার পর্যন্ত সপ্তাহ গণনার লজিক
        let diffMs = date - baseSaturday;
        let diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        let weekIndex = Math.floor(diffDays / 7);
        
        let currentShiftIdx = ((weekIndex % 3) + 3) % 3;

        if(isOffDay){
            duty = "OFF DAY";
            timeText = "-";
            cls = "off";
            statusBadge = `<span class="badge badge-off">ছুটি</span>`;
        } else {
            let currentShift = shifts[currentShiftIdx];
            duty = currentShift.name;
            timeText = currentShift.timeText;
            cls = "shift" + (currentShiftIdx + 1);

            let shiftStart = new Date(year, month - 1, d, currentShift.startHour, 0, 0);
            let shiftEnd = new Date(year, month - 1, d, currentShift.endHour, 0, 0);

            if (currentShift.isOvernight) {
                shiftEnd.setDate(shiftEnd.getDate() + 1);
            }

            if (now > shiftEnd) {
                statusBadge = `<span class="badge badge-finished">ডিউটি শেষ</span>`;
            } else if (now >= shiftStart && now <= shiftEnd) {
                statusBadge = `<span class="badge badge-running">ডিউটি রানিং</span>`;
                
                let diff = shiftEnd - now;
                let diffSecs = Math.floor(diff / 1000);

                let hrs = Math.floor(diffSecs / 3600);
                let mins = Math.floor((diffSecs % 3600) / 60);
                let secs = diffSecs % 60;

                timerInfo = `<div class="timer-text">⏳ শেষ হতে বাকি: ${padTwo(hrs)}:${padTwo(mins)}:${padTwo(secs)}</div>`;
            } else {
                statusBadge = `<span class="badge badge-upcoming">আসন্ন ডিউটি</span>`;
                
                if(now.toDateString() === date.toDateString()){
                    let diff = shiftStart - now;
                    let diffSecs = Math.floor(diff / 1000);
                    
                    if (diffSecs > 0) {
                        let hrs = Math.floor(diffSecs / 3600);
                        let mins = Math.floor((diffSecs % 3600) / 60);
                        let secs = diffSecs % 60;
                        timerInfo = `<div class="timer-text upcoming-timer">⏱️ শুরু হতে বাকি: ${padTwo(hrs)}:${padTwo(mins)}:${padTwo(secs)}</div>`;
                    }
                }
            }
        }

        // দিন বা মাস ফিল্টারিং
        if (!dateValue || (targetDay === d && targetMonth === parseInt(month) && targetYear === parseInt(year))) {
            html += `
            <tr class="${cls}">
                <td>${padTwo(d)}-${padTwo(month)}-${year}</td>
                <td>${dayName}</td>
                <td><strong>${duty}</strong><br><small>${timeText}</small></td>
                <td>${statusBadge}<br>${timerInfo}</td>
            </tr>
            `;

            // ফিল্টার করা প্রথম দিনের নোটিশ সেট করার জন্য
            if(activeShiftForNotice === null) {
                activeShiftForNotice = isOffDay ? "OFF" : shifts[currentShiftIdx];
            }
        }
    }

    if(html === "") {
        html = `<tr><td colspan="4">এই তারিখে কোনো তথ্য পাওয়া যায়নি</td></tr>`;
    }

    document.getElementById("result").innerHTML = html;

    // নিচের নোটিশ বক্স আপডেট করা
    updateNoticeCard(activeShiftForNotice);
}

function updateNoticeCard(shiftInfo) {
    let noticeContainer = document.getElementById("noticeContainer");

    if(!shiftInfo) {
        noticeContainer.innerHTML = "";
        return;
    }

    if(shiftInfo === "OFF") {
        noticeContainer.innerHTML = `
        <div class="notice-card" style="border-left-color: #e53935;">
            <div class="notice-title" style="color: #c62828;">📢 আজকের নোটিশ (সাপ্তাহিক ছুটি)</div>
            <p style="margin: 0; color: #555; font-size: 14px;">আজ আপনার সাপ্তাহিক ছুটির দিন। পর্যাপ্ত বিশ্রাম নিন, পরিবারের সাথে সময় কাটান এবং শরীর সুস্থ রাখুন।</p>
        </div>`;
    } else {
        let routineList = shiftInfo.routine.map(item => `<li>${item}</li>`).join("");
        noticeContainer.innerHTML = `
        <div class="notice-card">
            <div class="notice-title">📋 ${shiftInfo.name}-এর কার্যরুটিন ও পরামর্শ</div>
            <ul>${routineList}</ul>
            <div class="health-tips">💡 <strong>স্বাস্থ্য পরামর্শ:</strong> ${shiftInfo.tips}</div>
        </div>`;
    }
}

function showAllMonth(){
    document.getElementById("selectedDate").value = "";
    createDuty();
}

let today = new Date();
let m = padTwo(today.getMonth() + 1);
let d = padTwo(today.getDate());
let yyyy = today.getFullYear();

document.getElementById("month").value = yyyy + "-" + m;
document.getElementById("selectedDate").value = yyyy + "-" + m + "-" + d;

updateClock();
createDuty();

setInterval(() => {
    updateClock();
    createDuty();
}, 1000);

document.getElementById("month").addEventListener("change", function() {
    document.getElementById("selectedDate").value = "";
    createDuty();
});
document.getElementById("selectedDate").addEventListener("change", createDuty);

</script>

</body>
</html>
